# Copy to ah.toml. Paths are relative to this file.
home = ".ah"          # artifact store: store.db + blobs/
device = "auto"       # auto | cpu | cuda | cuda:0

[backends]            # local = tool's own uv env on this machine; remote = GPU server; inprocess = this interpreter
separate = "local"    # switch to "remote" once the Colab server is up
restore = "local"
denoise = "local"     # DeepFilterNet is faster than real time on CPU; its env needs Python 3.11, so not on Colab
analyze = "local"     # CPU is fine: a 32 s clip takes ~25 s with madmom here

[remote]
url = ""                       # https://<random>.trycloudflare.com from the notebook (or AH_REMOTE_URL)
token_env = "AH_REMOTE_TOKEN"  # the token itself never goes into this file
timeout_s = 900

[agent]                        # the LLM that plans tool calls from a request in plain words
provider = "anthropic"         # anthropic | openai (any OpenAI-compatible endpoint: OpenAI, OpenRouter, DeepSeek, Ollama, vLLM, LM Studio)
model = "claude-opus-5-5"
base_url = ""                  # e.g. http://localhost:11434/v1 for Ollama, https://openrouter.ai/api/v1
api_key_env = "ANTHROPIC_API_KEY"  # name of the env var with the key; the key itself never goes into this file
# DeepSeek (OpenAI-compatible, tool calls work with its default thinking mode):
#   provider = "openai", model = "deepseek-flash" (or "deepseek-v4-pro"),
#   base_url = "https://api.deepseek.com", api_key_env = "DEEPSEEK_API_KEY"
