# Copy to ah.toml. Paths are relative to this file.
home = ".ah"          # artifact store: store.db + blobs/
device = "auto"       # auto | cpu | cuda | cuda:0

[backends]            # local = tool's own uv env on this machine; remote = GPU server; inprocess = this interpreter
separate = "local"    # switch to "remote" once the Colab server is up
restore = "local"
analyze = "local"     # CPU is fine: a 32 s clip takes ~25 s with madmom here

[remote]
url = ""                       # https://<random>.trycloudflare.com from the notebook (or AH_REMOTE_URL)
token_env = "AH_REMOTE_TOKEN"  # the token itself never goes into this file
timeout_s = 900
